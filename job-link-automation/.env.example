# Supabase server-side configuration (never expose this key in a browser extension)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=replace_with_your_sb_secret_key

# Proposed defaults; confirm these before deployment
SCHEDULE_TIMEZONE=Asia/Kolkata
MORNING_RUN_TIME=09:00

# Comma-separated or newline-separated YouTube channels, public Telegram
# channels, and website pages. Each daily run discovers links from these sources.
DISCOVERY_SOURCES=https://www.youtube.com/@OnlineStudy4u,https://www.youtube.com/@hiremeplz,https://www.youtube.com/channel/UCcyogDO_BD5HS7YlySkTELQ,https://jobcode.in/,https://telegram.me/PLACEMENTLELO,https://t.me/offcampussdrive,https://t.me/jobs_and_internships_updates
DISCOVERY_TIMEFRAME=24h

BATCH_SIZE=50
REQUEST_TIMEOUT_MS=20000
