PORT=3000
# Use either OpenAI or OpenRouter. Do not set placeholders as real values.
OPENAI_API_KEY=
# Pick a JSON-capable OpenAI model available to your account.
OPENAI_MODEL=gpt-4.1-mini
# OPENROUTER_API_KEY=your_openrouter_key
# For an unlimited number of fallback keys, use a comma- or newline-separated list.
# OPENROUTER_API_KEYS=key_from_account_1,key_from_account_2,key_from_account_3
# Choose an OpenRouter model that supports structured outputs.
# OPENROUTER_MODEL=openai/gpt-4.1-mini
# Maximum generated tokens per extraction; keeps each request within credit limits.
AI_MAX_TOKENS=1200
# Set true only for the local worker so failed AI responses can be written to the audit table.
PARSER_AUDIT_MODE=false
# Optional comma-separated allowlist. Leave empty during local extension development.
ALLOWED_EXTENSION_ORIGINS=

# Daily apply-link parser worker (use GitHub Actions secrets in production)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Required only when the worker is run separately from the backend.
# GitHub Actions starts the parser locally and sets this automatically.
PARSER_API_URL=
WORKER_BATCH_LIMIT=50
WORKER_CONCURRENCY=3
HTTP_CONFIDENCE_THRESHOLD=7
